<settings>
	<setting propertyKey="@Properties.showLastLap_prop"
		title="@Strings.showLastLap_prop">
		<settingConfig type="boolean" />
	</setting>
	<setting propertyKey="@Properties.lapchart"
		title="@Strings.lapchart">
		<settingConfig type="boolean" />
	</setting>
	<setting propertyKey="@Properties.secondline"
		title="@Strings.secondline">
		<settingConfig type="list">
			<listEntry value="0">@Strings.secondline0</listEntry>
			<listEntry value="1">@Strings.secondline1</listEntry>
			<listEntry value="2">@Strings.secondline2</listEntry>
			<listEntry value="3">@Strings.secondline3</listEntry>
			<listEntry value="4">@Strings.secondline4</listEntry>
			<listEntry value="5">@Strings.secondline5</listEntry>
			<listEntry value="6">@Strings.secondline6</listEntry>
			<listEntry value="7">@Strings.secondline7</listEntry>
			<listEntry value="8">@Strings.secondline8</listEntry>
			<listEntry value="9">@Strings.secondline9</listEntry>
			<listEntry value="10">@Strings.secondline10</listEntry>
			<listEntry value="11">@Strings.secondline11</listEntry>
		</settingConfig>
	</setting>
	<setting propertyKey="@Properties.hideLabel"
		title="@Strings.hideLabel">
		<settingConfig type="boolean" />
	</setting>
	<setting propertyKey="@Properties.zerotoone"
		title="@Strings.zerotoone"
		prompt="@Strings.digitsprompt">
        <settingConfig type="numeric" required="true" min="0" max="3" />
	</setting>
	<setting propertyKey="@Properties.onetoten"
		title="@Strings.onetoten"
		prompt="@Strings.digitsprompt">
        <settingConfig type="numeric" required="true" min="0" max="3" />
	</setting>
	<setting propertyKey="@Properties.tentohundred"
		title="@Strings.tentohundred"
		prompt="@Strings.digitsprompt">
        <settingConfig type="numeric" required="true" min="0" max="3" />
	</setting>
	<setting propertyKey="@Properties.hundredonwards"
		title="@Strings.hundredonwards"
		prompt="@Strings.digitsprompt">
        <settingConfig type="numeric" required="true" min="0" max="3" />
	</setting>
	<setting propertyKey="@Properties.overridesizeing"
		title="@Strings.overridesizeing"
		prompt="@Strings.digitsprompt">
        <settingConfig type="boolean" required="false" />
	</setting>
	<setting propertyKey="@Properties.heightoversizeoverride"
		title="@Strings.heightoversizeoverride"
		prompt="@Strings.oversizeoverridepromptvalue">
        <settingConfig type="numeric" required="false" min="50" max="150" />
	</setting>
	<setting propertyKey="@Properties.widthoversizeoverride"
		title="@Strings.widthoversizeoverride"
		prompt="@Strings.oversizeoverridepromptvalue">
        <settingConfig type="numeric" required="false" min="50" max="150" />
	</setting>
	<!-- <setting propertyKey="@Properties.debugmode"
		title="@Strings.debugmode">
        <settingConfig type="boolean" required="false" />
	</setting>	 -->
</settings>